{
	"schemaVersion": 1,
	"id": "foot-box",
	"version": "${version}",
	"name": "FootBox",
	"description": "Displays a wireframe hitbox in first person to show what you can stand on.",
	"authors": [
		"zackdcat"
	],
	"contact": {
		"email": "zwhseton@gmail.com",
		"sources": "https://github.com/zackdcat/foot-box",
		"issues": "https://github.com/zackdcat/foot-box/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/foot-box/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.zackdcat.footbox.FootBox"
		]
	},
	"mixins": [
		"foot-box.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": ">=1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"badges": ["clientside"],
			"update_checker": true,
			"links": {
				"modmenu.issues": "https://github.com/zackdcat/foot-box/issues",
				"modmenu.sources": "https://github.com/zackdcat/foot-box",
				"modmenu.modrinth": "https://modrinth.com/mod/footbox"
			}
		}
	}
}